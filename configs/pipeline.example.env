# Конфигурация пайплайна. Скопируйте в pipeline.env и правьте под себя:
#   cp configs/pipeline.example.env configs/pipeline.env

# --- Object storage (RustFS) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=hh-lake
S3_REGION=us-east-1
S3_PREFIX_RAW=raw/
S3_PREFIX_RESULTS=results/

# --- Входные данные ---
INPUT_OBJECT=raw/it_vacancies_2024.csv
LOCAL_INPUT=data/raw/it_vacancies_2024.csv

# --- Локальные каталоги вывода ---
OUTPUT_DIR=data/results
REPORT_DIR=reports/output
PROFILE_DIR=profiling/output

# --- Параметры MapReduce ---
CHUNK_SIZE_MB=64
WORKERS=4
REDUCERS=4

# --- Параметры DuckDB ---
# На машине <1 ГБ свободной RAM: лимит памяти и число потоков задаются явно,
# иначе DuckDB падает на старте с "Memory allocation still failed".
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2
